# ===========================================================
#  Gameday Guides — git ignore rules
# ===========================================================

# --- Secrets: NEVER commit (this repo is public) ---
# Accounts + bcrypt password hashes. Use data/users.sample.json as the
# template and create data/users.json on the server.
data/users.json
config.local.php

# --- Uploaded images & runtime media ---
# The uploads folder is tracked (so it exists on a fresh clone) but its
# contents are not — each school's images live under uploads/{slug}/ on
# the server and are managed through the admin panel.
uploads/*
!uploads/.gitkeep

# --- Per-school content (runtime, server-owned) ---
# All school content is edited live in the admin and lives on the server, so
# it never rides along with a code deploy and an auto-pull can't overwrite it.
# (Homewood's migrated copy is recoverable from git history and the deploy zip.)
data/schools/*.json

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# --- Logs / temp ---
*.log
*.tmp
