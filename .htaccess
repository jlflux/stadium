# ===========================================================
#  Gameday Guides — Apache config
# ===========================================================

# --- Larger image uploads (the admin shrinks them anyway) ---
php_value upload_max_filesize 16M
php_value post_max_size 20M
php_value memory_limit 256M

# --- Pretty URLs: /{school-slug} -> index.php front controller ---
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Convenience: /admin -> admin.php
  RewriteRule ^admin/?$ admin.php [L]

  # Serve real files and folders directly (admin.php, uploads/, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is routed to the front controller
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# --- Don't list directories ---
Options -Indexes
